{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/status.sh\"",
            "timeout": 15,
            "statusMessage": "Blueprint: lendo o estado do projeto"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/docs-integrity.sh\"",
            "timeout": 15,
            "statusMessage": "Blueprint: integridade da documentacao"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/tests-integrity.sh\"",
            "timeout": 15,
            "statusMessage": "Blueprint: integridade da suite de testes"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-secrets.sh\"",
            "timeout": 20,
            "statusMessage": "Blueprint: varredura de credenciais"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/docs-complete.sh\"",
            "timeout": 15,
            "statusMessage": "Blueprint: placeholders restantes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
